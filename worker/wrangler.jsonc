{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gmgn-ai-trader-api",
  "main": "index.js",
  "compatibility_date": "2026-11-14",
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gmgn-ai-trader-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
